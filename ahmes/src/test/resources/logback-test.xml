<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger - INFO level for tests -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Ahmes library - DEBUG for testing -->
    <logger name="com.pascal.institute.ahmes" level="DEBUG" />

    <!-- Reduce noise from third-party libraries during tests -->
    <logger name="ai.djl" level="ERROR" />
    <logger name="org.apache.pdfbox" level="ERROR" />
    <logger name="org.apache.tika" level="ERROR" />
</configuration>
